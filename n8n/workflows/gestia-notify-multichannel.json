{
  "name": "gestia-notify-multichannel",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "gestia/notify",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-notify",
      "name": "Webhook Notify",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "gestia-notify"
    },
    {
      "parameters": {
        "functionCode": "// Validate and route by channel\nconst { notification_id, tenant_id, canal, destinatario_tipo, destinatario_id, asunto, cuerpo, cuerpo_html, template_id, template_data, external_id } = $json;\n\nif (!notification_id || !canal) {\n  throw new Error('Missing notification_id or canal');\n}\n\nconst channelMap = {\n  'email': 'Send Email',\n  'whatsapp': 'Send WhatsApp',\n  'slack': 'Send Slack',\n  'portal': 'Portal (no-op)',\n  'sms': 'Send SMS',\n  'push': 'Send Push'\n};\n\nreturn [{ json: { ...$json, target_node: channelMap[canal] || 'Portal (no-op)' } }];"
      },
      "id": "route-by-channel",
      "name": "Route by Channel",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [500, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.target_node}}",
              "operation": "equal",
              "value2": "Send Email"
            }
          ]
        }
      },
      "id": "if-email",
      "name": "IF Email",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [750, 200]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.target_node}}",
              "operation": "equal",
              "value2": "Send WhatsApp"
            }
          ]
        }
      },
      "id": "if-whatsapp",
      "name": "IF WhatsApp",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [750, 400]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.target_node}}",
              "operation": "equal",
              "value2": "Send Slack"
            }
          ]
        }
      },
      "id": "if-slack",
      "name": "IF Slack",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [750, 600]
    },
    {
      "parameters": {
        "fromEmail": "noreply@gestia.app",
        "toEmail": "={{$json.template_data.email || $json.destinatario_email}}",
        "subject": "={{$json.asunto}}",
        "text": "={{$json.cuerpo}}",
        "html": "={{$json.cuerpo_html || $json.cuerpo}}",
        "options": {}
      },
      "id": "send-email",
      "name": "Send Email (SendGrid)",
      "type": "n8n-nodes-base.sendGrid",
      "typeVersion": 2,
      "position": [1000, 200],
      "credentials": {
        "sendGridApi": "SendGrid API"
      }
    },
    {
      "parameters": {
        "phoneNumber": "={{$json.template_data.phone || $json.destinatario_phone}}",
        "message": "={{$json.cuerpo}}",
        "options": {}
      },
      "id": "send-whatsapp",
      "name": "Send WhatsApp (360Dialog)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1000, 400],
      "credentials": {
        "httpHeaderAuth": "360Dialog API"
      }
    },
    {
      "parameters": {
        "channel": "={{$json.template_data.slack_channel || '#general'}}",
        "text": "={{$json.asunto}}\n{{$json.cuerpo}}",
        "options": {}
      },
      "id": "send-slack",
      "name": "Send Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.1,
      "position": [1000, 600],
      "credentials": {
        "slackApi": "Slack API"
      }
    },
    {
      "parameters": {
        "functionCode": "// Portal notification - just update status in GESTIA\nreturn [{ json: { ...$json, portal_sent: true } }];"
      },
      "id": "portal-noop",
      "name": "Portal (DB update)",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [1000, 800]
    },
    {
      "parameters": {
        "mode": "merge",
        "options": {}
      },
      "id": "merge-results",
      "name": "Merge Results",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 2,
      "position": [1250, 400]
    },
    {
      "parameters": {
        "url": "http://gestia-api:8000/internal/n8n/callback/notification",
        "method": "POST",
        "jsonParameters": true,
        "options": {},
        "bodyParametersJson": "={{ { notification_id: $json.notification_id, external_id: $json.external_id || $json.id || $json.message_id, status: $json.success ? 'sent' : 'failed', error: $json.error } }}"
      },
      "id": "callback-notification",
      "name": "Notification Callback",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1500, 400],
      "credentials": {
        "httpHeaderAuth": "GESTIA Internal API"
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseCode": 200,
        "responseHeaders": {},
        "jsonParameters": true,
        "options": {},
        "bodyParametersJson": "={{ { status: 'queued', notification_id: $json.notification_id } }}"
      },
      "id": "webhook-response",
      "name": "Webhook Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [500, 500]
    }
  ],
