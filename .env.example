# ============================================
# GESTIA — Environment Variables Template
# ============================================
# Copia a .env y rellena los valores.
# NUNCA commitees .env real (está en .gitignore)
# ============================================

# --------------------------------------------
# APP / ENVIRONMENT
# --------------------------------------------
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# --------------------------------------------
# DATABASE (PostgreSQL + pgvector)
# --------------------------------------------
POSTGRES_USER=gestia
POSTGRES_PASSWORD=changeme_strong_password_here
POSTGRES_DB=gestia
# DATABASE_URL se construye en docker-compose, pero para uso local:
# DATABASE_URL=postgresql+asyncpg://gestia:changeme@localhost:5432/gestia

# --------------------------------------------
# REDIS (Cache, Rate-limiting, Celery broker)
# --------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --------------------------------------------
# MINIO / S3 (Document Vault - Object Storage)
# --------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=gestia
MINIO_ROOT_PASSWORD=changeme123_strong
MINIO_BUCKET=gestia-documents
MINIO_SECURE=false  # true en producción con TLS

# --------------------------------------------
# N8N (Workflow Automation)
# --------------------------------------------
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
N8N_ENCRYPTION_KEY=generate_with_openssl_rand_base64_32
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme_n8n_password
N8N_API_KEY=generate_strong_random_string

# N8N Webhook endpoints (GESTIA → n8n)
N8N_WEBHOOK_BASE_URL=http://localhost:5678/webhook/gestia

# --------------------------------------------
# AUTH / JWT
# --------------------------------------------
JWT_SECRET_KEY=generate_very_long_random_string_at_least_64_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# MFA / Passkeys
MFA_ISSUER=GESTIA
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=GESTIA

# --------------------------------------------
# OPENAI / OPENROUTER / LLM PROVIDERS
# --------------------------------------------
# Modelos gratuitos preferidos (con -free suffix)
OPENROUTER_API_KEY=sk-or-v1-xxxxx
OPENAI_API_KEY=sk-xxxxx
GEMINI_API_KEY=xxxxxx
DEEPSEEK_API_KEY=xxxxxx

# Modelos por defecto
DEFAULT_LLM_MODEL=deepseek/deepseek-chat
DEFAULT_LLM_PROVIDER=openrouter
EMBEDDING_MODEL=text-embedding-3-small

# Modelos gratuitos (para routing inteligente)
FREE_MODELS=solar-pro4-free,gemini-3.6-flash-free,deepseek-v4-flash-free,qwen3.8-flash-next,glm-5.3-flash,gemma-4

# --------------------------------------------
# OCR / DOCUMENT PROCESSING
# --------------------------------------------
# Docling (local, gratuito, bueno para tablas)
DOCLING_ENABLED=true
DOCLING_DEVICE=cpu  # o cuda si tienes GPU
OCR_LANGUAGES=es,en

# Azure Document Intelligence (opcional, si Docling no basta)
AZURE_DOC_INTEL_ENDPOINT=
AZURE_DOC_INTEL_KEY=

# --------------------------------------------
# EMAIL (Notificaciones, Inbound parsing)
# --------------------------------------------
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=SG.xxxxx
EMAIL_FROM=noreply@gestia.app
EMAIL_FROM_NAME=GESTIA

# Inbound email (para parsing facturas/docs por email)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=docs@gestia.app
IMAP_PASSWORD=app_password_here
IMAP_OAUTH2=false

# --------------------------------------------
# WHATSAPP BUSINESS (360Dialog / Meta)
# --------------------------------------------
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=360dialog  # o meta, twilio
WHATSAPP_API_KEY=xxxxxx
WHATSAPP_PHONE_NUMBER_ID=xxxxxx
WHATSAPP_WEBHOOK_VERIFY_TOKEN=generate_random_string

# --------------------------------------------
# EXTERNAL APIs (AEAT, Seguridad Social, Registros)
# --------------------------------------------
AEAT_CERT_PATH=/app/certs/aeat.p12
AEAT_CERT_PASSWORD=
SS_RED_SISTEMA_API_KEY=xxxxxx
SS_RED_SISTEMA_USER=xxxxxx
SS_RED_SISTEMA_PASS=xxxxxx

# --------------------------------------------
# MONITORING / OBSERVABILITY
# --------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_METRICS_PORT=9090
GRAFANA_URL=http://localhost:3000

# --------------------------------------------
# FEATURE FLAGS
# --------------------------------------------
FEATURE_OCR=true
FEATURE_RAG=true
FEATURE_WHATSAPP=false
FEATURE_API_SYNC=true
FEATURE_WEB_UI=true